# Headers HTTP de sécurité pour l'app Flutter Web (#310).
# Consommé par Netlify et Cloudflare Pages (pas par GitHub Pages).
# Copié dans build/web au déploiement (voir cd.yaml deploy-web).
#
# https://docs.netlify.com/routing/headers/
# https://developers.cloudflare.com/pages/configuration/headers/

# Bascule CSP en deux temps (#973) : la politique appliquée conserve
# 'unsafe-inline'/'unsafe-eval' tant que les rapports n'ont pas confirmé que
# Flutter Web fonctionne sans. La variante Report-Only teste la cible sans
# risquer un écran blanc. Après 24-48 h de rapports vierges, copier la valeur
# Report-Only dans Content-Security-Policy et supprimer la ligne Report-Only
# (voir TODO WEB-SEC-HEADERS-OPS-01).
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: wss:; worker-src 'self' blob:; form-action 'self'
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: wss:; worker-src 'self' blob:; form-action 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-XSS-Protection: 0

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  Cache-Control: public, max-age=86400

/icons/*
  Cache-Control: public, max-age=31536000, immutable
